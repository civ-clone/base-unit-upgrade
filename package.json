{
  "name": "@civ-clone/base-unit-upgrade",
  "version": "0.1.0",
  "description": "Upgrading units to a newer type of the same role: the target lookup, upgrading every eligible unit at once, and the Upgraded rules.",
  "repository": "git@github.com:civ-clone/base-unit-upgrade.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-game": "^0.1.17",
    "@civ-clone/core-save-game": "^0.1.23",
    "@civ-clone/core-world": "^0.1.24",
    "@civ-clone/core-yield": "^0.1.0",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-unit-role": "^0.1.1",
    "@civ-clone/core-engine": "^0.1.6",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-science": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-unit-improvement": "^0.1.3",
    "@civ-clone/core-unit-transport": "^0.1.10"
  }
}
